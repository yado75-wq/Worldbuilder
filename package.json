{
  "name": "world-builder-tools",
  "version": "1.0.1",
  "private": true,
  "description": "Template-driven worldbuilding tools for Obsidian",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "check-id": "node check-plugin-id.mjs",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.1",
    "esbuild": "^0.25.12",
    "eslint": "^9.0.0",
    "eslint-plugin-obsidianmd": "^0.1.0",
    "globals": "^15.0.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.0",
    "obsidian": "^1.13.1",
    "typescript": "^5.5.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "brace-expansion": ">=5.0.8",
    "minimatch": {
      "brace-expansion": ">=5.0.8"
    }
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
